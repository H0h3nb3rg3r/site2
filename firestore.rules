rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Test-drives enviados pelo formulário
    match /agendamentos/{doc} {
      allow create: if true;
    }

    // Estoque de carros (somente leitura pública)
    match /carros/{doc} {
      allow read: if true;
    }

    match /pedidos/{id} {
        allow create: if request.resource.data.keys().hasAll(['carro', 'nome', 'cpf', 'entrega', 'pagamento'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() < 120;
    }

    // Acrescente aqui a regra do formulário de contato que você já tinha
  }
}