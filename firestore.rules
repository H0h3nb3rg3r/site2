rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do cliente: só o próprio dono lê e grava
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Test-drives: qualquer pessoa cria; quem está logado lê só os seus
    match /agendamentos/{doc} {
      allow create: if request.resource.data.get('uid', null) == null
                    || (request.auth != null && request.resource.data.uid == request.auth.uid);
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Estoque de carros (somente leitura pública)
    match /carros/{doc} {
      allow read: if true;
    }

    // Pedidos: qualquer pessoa cria; quem está logado lê só os seus
    match /pedidos/{id} {
      allow create: if request.resource.data.keys().hasAll(['carro', 'nome', 'cpf', 'entrega', 'pagamento'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() < 120
                    && (request.resource.data.get('uid', null) == null
                        || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}